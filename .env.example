# Database: Postgres. Supabase -> Project Settings -> Database -> Connection string.
# On Vercel/serverless use the "Transaction pooler" URI (port 6543); locally the direct URI works.
# URL-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase project. When set, owner login uses Supabase Auth and product photos go to Supabase Storage.
# Without them (local dev) the app falls back to its built-in login and local disk.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=product-images


# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=

# First owner account (created by `npm run db:seed`; password change forced on first login).
# Wrap the password in double quotes if it contains # or spaces; minimum 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Store WhatsApp number, international format, digits only (91 + 10-digit mobile)
STORE_WHATSAPP=91XXXXXXXXXX

# Public URL of the site (used in WhatsApp messages, bills, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image storage: local (writes to public/uploads, for dev or a VPS) or supabase (Supabase Storage)
STORAGE_DRIVER=local
